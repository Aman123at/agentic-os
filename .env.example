# Copy to .env and adjust. Compose reads this file only to fill in compose.yaml.

# cli or ui (selects the image target and runtime behaviour)
AOS_MODE=ui

# true adds the Browser app to the Desktop (ui Mode only; ignored in cli Mode).
# Chromium's headless shell, about 250 MB more image. Rebuild after changing it:
# docker compose up --build
INCLUDE_BROWSER=false

# Delivered to aosd as a secret file, never as an environment variable.
# Set a spending cap on your OpenAI project.
OPENAI_API_KEY=

# Model for Agents (default gpt-5.6-terra). System Settings overrides this.
OPENAI_MODEL=
OPENAI_REASONING_EFFORT=
OPENAI_BASE_URL=

# Host port and interface. Anything other than 127.0.0.1 exposes AOS to your network.
AOS_PORT=7700
AOS_BIND=127.0.0.1

# Overrides the generated API access token.
AOS_ACCESS_TOKEN=

# auto | confirm-risky | confirm-all
AOS_AUTONOMY=confirm-risky
AOS_MAX_TASKS=3
AOS_MAX_RETRIES=3

# Optional Cost Limits in USD (unset = no limit)
AOS_TASK_COST_LIMIT_USD=
AOS_DAILY_COST_LIMIT_USD=

# Refuse to start on Hosts without Landlock
AOS_REQUIRE_LANDLOCK=false

# Linux Hosts: match your user so Shared Folder files are owned by you
AOS_UID=1000
AOS_GID=1000

# Host path of the Shared Folder (Windows paths such as C:\Users\me\aos work)
AOS_SHARED_DIR=./shared

# Extra published ports for compose.override.yaml, e.g. 8000-8010
AOS_PUBLISH_PORTS=

AOS_TRASH_RETENTION_DAYS=30
AOS_TRASH_MAX_GB=5
TZ=UTC
